{
  "name": "@rotki/eslint-plugin",
  "version": "1.7.1",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "type": "module",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/rotki/eslint-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rotki/eslint-plugin.git"
  },
  "author": "Rotki Solutions GmbH <info@rotki.com>",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf .nyc_output coverage dist docs/.vitepress/dist",
    "coverage": "nyc report --reporter lcov && opener coverage/lcov-report/index.html",
    "generate": "tsx scripts/update-rule-docs.ts",
    "generate:index": "tsx scripts/update-docs-index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "new": "tsx ./scripts/new-rule.ts",
    "docs": "vitepress dev docs",
    "docs:build": "pnpm run generate && pnpm run generate:index && vitepress build docs",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "release": "bumpp -r --no-push"
  },
  "peerDependencies": {
    "eslint": "^9.20.0 || ^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.68.0",
    "@typescript-eslint/utils": "8.68.0",
    "debug": "4.4.3",
    "jsonc-eslint-parser": "3.3.0",
    "scule": "1.3.0",
    "tinyglobby": "0.2.17",
    "vue-eslint-parser": "10.4.1",
    "yaml-eslint-parser": "2.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@rotki/eslint-config": "8.0.0",
    "@rotki/eslint-plugin": "1.5.1",
    "@types/debug": "4.1.13",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/rule-tester": "8.68.0",
    "@vitest/coverage-v8": "4.1.11",
    "bumpp": "11.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-tsdoc": "0.5.2",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "oxc-minify": "0.147.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "unbuild": "3.6.1",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <12"
  },
  "lint-staged": {
    "*.{js,cjs,ts,vue,yml,json,md}": "eslint"
  }
}
