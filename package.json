{
  "name": "@rotki/eslint-plugin",
  "version": "1.10.1",
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "type": "module",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/rotki/eslint-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rotki/eslint-plugin.git"
  },
  "author": "Rotki Solutions GmbH <info@rotki.com>",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf .nyc_output coverage dist docs/.vitepress/dist",
    "coverage": "nyc report --reporter lcov && opener coverage/lcov-report/index.html",
    "generate": "tsx scripts/update-rule-docs.ts",
    "generate:index": "tsx scripts/update-docs-index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:workflows": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 -color && uvx --from zizmor==1.32.0 zizmor .github/workflows",
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "new": "tsx ./scripts/new-rule.ts",
    "docs": "vitepress dev docs",
    "docs:build": "pnpm run generate && pnpm run generate:index && vitepress build docs",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "release": "bumpp -r --no-push"
  },
  "peerDependencies": {
    "eslint": "^9.20.0 || ^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.73.0",
    "@typescript-eslint/utils": "8.73.0",
    "debug": "4.4.3",
    "jsonc-eslint-parser": "3.3.0",
    "scule": "1.3.0",
    "tinyglobby": "0.2.17",
    "vue-eslint-parser": "10.4.2",
    "yaml-eslint-parser": "2.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@rotki/eslint-config": "8.4.1",
    "@rotki/eslint-plugin": "1.10.0",
    "@types/debug": "4.1.13",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/rule-tester": "8.73.0",
    "@vitest/coverage-v8": "5.1.1",
    "bumpp": "12.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-slop": "0.1.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxc-minify": "0.159.0",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unbuild": "3.6.1",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <13"
  },
  "lint-staged": {
    "*.{js,cjs,ts,vue,yml,json,md}": "eslint"
  }
}
