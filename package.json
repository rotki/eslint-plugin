{
  "name": "@rotki/eslint-plugin",
  "version": "1.10.0",
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4",
  "type": "module",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/rotki/eslint-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rotki/eslint-plugin.git"
  },
  "author": "Rotki Solutions GmbH <info@rotki.com>",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf .nyc_output coverage dist docs/.vitepress/dist",
    "coverage": "nyc report --reporter lcov && opener coverage/lcov-report/index.html",
    "generate": "tsx scripts/update-rule-docs.ts",
    "generate:index": "tsx scripts/update-docs-index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "new": "tsx ./scripts/new-rule.ts",
    "docs": "vitepress dev docs",
    "docs:build": "pnpm run generate && pnpm run generate:index && vitepress build docs",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "release": "bumpp -r --no-push"
  },
  "peerDependencies": {
    "eslint": "^9.20.0 || ^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/utils": "8.71.2",
    "debug": "4.4.3",
    "jsonc-eslint-parser": "3.3.0",
    "scule": "1.3.0",
    "tinyglobby": "0.2.17",
    "vue-eslint-parser": "10.4.1",
    "yaml-eslint-parser": "2.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@rotki/eslint-config": "8.4.1",
    "@rotki/eslint-plugin": "1.10.0",
    "@types/debug": "4.1.13",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/rule-tester": "8.71.2",
    "@vitest/coverage-v8": "5.0.4",
    "bumpp": "12.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxc-minify": "0.154.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unbuild": "3.6.1",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <13"
  },
  "lint-staged": {
    "*.{js,cjs,ts,vue,yml,json,md}": "eslint"
  }
}
